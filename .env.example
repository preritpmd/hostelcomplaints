# Copy these into your cloud host's "Environment" settings. Never commit real values.
DATABASE_URL=postgresql://user:password@host:5432/dbname
SECRET_KEY=paste-a-long-random-string-here
# One secretary per hostel (H1, H2) or ALL to see everything. Separate accounts with ;
ADMINS=h2sec@iitdh.ac.in|ChooseAStrongPassword|H2;h1sec@iitdh.ac.in|AnotherStrongPassword|H1
# Only if the frontend is hosted on a DIFFERENT domain than the API:
# CORS_ORIGIN=https://your-frontend-domain.example
